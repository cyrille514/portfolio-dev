---
import type { ProjectItem } from '../data/portfolioData';

interface Props {
  project: ProjectItem;
  labels: { liveDemo: string; sourceCode: string; keyPoints: string };
}

const { project, labels } = Astro.props;
---

<article class="flex flex-col justify-between rounded-2xl border border-zinc-800 bg-zinc-900/70 p-6 transition-colors hover:border-zinc-700">
  <div class="space-y-4">
    <span class="inline-block rounded-full border border-indigo-500/30 bg-indigo-500/10 px-3 py-1 text-[11px] font-medium text-indigo-300">
      {project.badge}
    </span>

    <div class="space-y-2">
      <h3 class="text-lg font-semibold text-white">{project.title}</h3>
      <p class="text-sm leading-relaxed text-zinc-400">{project.description}</p>
    </div>

    <div class="space-y-2">
      <p class="text-xs font-semibold uppercase tracking-wider text-zinc-500">{labels.keyPoints}</p>
      <ul class="space-y-1.5 text-xs text-zinc-300">
        {project.highlights.map((item) => (
          <li class="flex items-start gap-2">
            <span class="mt-1 h-1.5 w-1.5 shrink-0 rounded-full bg-indigo-400"></span>
            <span>{item}</span>
          </li>
        ))}
      </ul>
    </div>
  </div>

  <div class="mt-6 space-y-4 border-t border-zinc-800/80 pt-4">
    <div class="flex flex-wrap gap-1.5">
      {project.stack.map((tech) => (
        <span class="rounded-md bg-zinc-800 px-2.5 py-1 text-[11px] font-medium text-zinc-300">
          {tech}
        </span>
      ))}
    </div>

    <div class="flex items-center gap-3">
      {project.liveUrl !== '#' && (
        <a
          href={project.liveUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="rounded-lg bg-white px-3.5 py-2 text-xs font-semibold text-zinc-950 transition-colors hover:bg-zinc-200"
        >
          {labels.liveDemo} ↗
        </a>
      )}
      <a
        href={project.repoUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="rounded-lg border border-zinc-700 px-3.5 py-2 text-xs font-semibold text-zinc-200 transition-colors hover:border-zinc-500 hover:text-white"
      >
        {labels.sourceCode}
      </a>
    </div>
  </div>
</article>
