---
import type { Lang } from '../data/portfolioData';

interface Props {
  lang: Lang;
  nav: { about: string; projects: string; skills: string; contact: string };
}

const { lang, nav } = Astro.props;
---

<header class="sticky top-0 z-50 border-b border-zinc-800/80 bg-zinc-950/90 backdrop-blur">
  <div class="mx-auto flex max-w-5xl items-center justify-between px-4 py-4 sm:px-6">
    <a href={lang === 'fr' ? '/' : '/es'} class="text-sm font-bold tracking-tight text-white">
      Cyrille<span class="text-indigo-400">.dev</span>
    </a>

    <nav class="hidden items-center gap-6 text-xs font-medium text-zinc-400 sm:flex">
      <a href="#projects" class="transition-colors hover:text-white">{nav.projects}</a>
      <a href="#skills" class="transition-colors hover:text-white">{nav.skills}</a>
      <a href="#about" class="transition-colors hover:text-white">{nav.about}</a>
      <a href="#contact" class="transition-colors hover:text-white">{nav.contact}</a>
    </nav>

    <div class="flex items-center gap-1 rounded-lg border border-zinc-800 bg-zinc-900 p-1 text-xs font-semibold">
      <a
        href="/"
        class={`rounded-md px-2.5 py-1 transition-colors ${
          lang === 'fr' ? 'bg-indigo-600 text-white' : 'text-zinc-400 hover:text-white'
        }`}
      >
        FR
      </a>
      <a
        href="/es"
        class={`rounded-md px-2.5 py-1 transition-colors ${
          lang === 'es' ? 'bg-indigo-600 text-white' : 'text-zinc-400 hover:text-white'
        }`}
      >
        ES
      </a>
    </div>
  </div>
</header>
