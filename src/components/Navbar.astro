---
import type { Lang } from '../data/portfolioData';

interface Props {
  lang: Lang;
  nav: { about: string; projects: string; skills: string; contact: string };
}

const { lang, nav } = Astro.props;
---

<header class="sticky top-0 z-50 w-full border-b border-zinc-800/80 bg-zinc-950/90 backdrop-blur-md">
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-3 px-4 sm:px-6 lg:px-8">
    <a
      href={lang === 'fr' ? '/' : '/es'}
      class="shrink-0 text-sm font-semibold tracking-tight text-white transition-colors hover:text-zinc-200 sm:text-base"
    >
      Cyrille<span class="text-indigo-400">.dev</span>
    </a>

    <nav aria-label="Primary" class="hidden items-center gap-6 text-sm font-medium text-zinc-400 md:flex lg:gap-8">
      <a href="#projects" class="whitespace-nowrap text-green-500  transition-colors hover:text-violet-500">{nav.projects}</a>
      <a href="#skills" class="whitespace-nowrap transition-colors hover:text-violet-500">{nav.skills}</a>
      <a href="#about" class="whitespace-nowrap text-green-500 transition-colors hover:text-violet-500">{nav.about}</a>
      <a href="#contact" class="whitespace-nowrap text-green-500 transition-colors hover:text-violet-500">{nav.contact}</a>
    </nav>

    <div class="flex shrink-0 items-center rounded-lg border border-zinc-800 bg-zinc-900 p-1 text-xs font-semibold">
      <a
        href="/"
        aria-current={lang === 'fr' ? 'page' : undefined}
        class={`rounded-md px-2.5 py-1.5 transition-colors ${
          lang === 'fr' ? 'bg-indigo-600 text-white' : 'text-zinc-400 hover:text-white'
        }`}
      >
        FR
      </a>
      <a
        href="/es"
        aria-current={lang === 'es' ? 'page' : undefined}
        class={`rounded-md px-2.5 py-1.5 transition-colors ${
          lang === 'es' ? 'bg-indigo-600 text-white' : 'text-zinc-400 hover:text-white'
        }`}
      >
        ES
      </a>
    </div>
  </div>
</header>
