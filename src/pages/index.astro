---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { portfolioContent } from '../data/portfolioData';

const t = portfolioContent.fr;
---

<BaseLayout lang="fr">
  <section class="space-y-6 pb-16">
    <span class="inline-block rounded-full border border-zinc-800 bg-zinc-900 px-3.5 py-1 text-xs font-medium text-indigo-400">
      {t.role}
    </span>
    <h1 class="max-w-3xl text-3xl font-bold tracking-tight text-white sm:text-5xl">
      {t.heroTitle}
    </h1>
    <p class="max-w-2xl text-sm leading-relaxed text-zinc-400 sm:text-base">
      {t.heroSubtitle}
    </p>
    <div class="flex flex-wrap gap-3 pt-2">
      <a href="#projects" class="rounded-xl bg-indigo-600 px-5 py-2.5 text-xs font-semibold text-white transition-colors hover:bg-indigo-500">
        {t.ctaProjects}
      </a>
      <a href="#contact" class="rounded-xl border border-zinc-700 px-5 py-2.5 text-xs font-semibold text-zinc-200 transition-colors hover:border-zinc-500 hover:text-white">
        {t.ctaContact}
      </a>
    </div>
  </section>

  <section id="projects" class="space-y-6 border-t border-zinc-800/80 py-14">
    <div>
      <h2 class="text-2xl font-bold text-white">{t.sections.projectsTitle}</h2>
      <p class="mt-1 text-sm text-zinc-400">{t.sections.projectsSubtitle}</p>
    </div>
    <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
      {t.projects.map((project) => (
        <ProjectCard project={project} labels={t.labels} />
      ))}
    </div>
  </section>

  <section id="skills" class="space-y-6 border-t border-zinc-800/80 py-14">
    <h2 class="text-2xl font-bold text-white">{t.sections.skillsTitle}</h2>
    <div class="grid grid-cols-1 gap-6 sm:grid-cols-3">
      {t.skills.map((group) => (
        <div class="rounded-2xl border border-zinc-800 bg-zinc-900/50 p-5">
          <h3 class="text-sm font-semibold text-white">{group.category}</h3>
          <div class="mt-3 flex flex-wrap gap-2">
            {group.items.map((skill) => (
              <span class="rounded-lg border border-zinc-800 bg-zinc-950 px-2.5 py-1 text-xs text-zinc-300">
                {skill}
              </span>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>

  <section id="about" class="grid grid-cols-1 gap-8 border-t border-zinc-800/80 py-14 md:grid-cols-2">
    <div class="space-y-3">
      <h2 class="text-2xl font-bold text-white">{t.sections.aboutTitle}</h2>
      <p class="text-sm leading-relaxed text-zinc-400">{t.sections.aboutText}</p>
    </div>
    <div id="contact" class="space-y-4 rounded-2xl border border-zinc-800 bg-zinc-900/60 p-6">
      <h2 class="text-xl font-bold text-white">{t.sections.contactTitle}</h2>
      <p class="text-sm leading-relaxed text-zinc-400">{t.sections.contactText}</p>
      <div class="flex flex-wrap gap-3 pt-1">
        <a href="mailto:cyrillenyamitchamba67@gmail.com" class="rounded-lg bg-white px-4 py-2 text-xs font-semibold text-zinc-950 hover:bg-zinc-200">
          cyrillenyamitchamba67@gmail.com
        </a>
        <a href="https://github.com/cyrille514" target="_blank" rel="noopener noreferrer" class="rounded-lg border border-zinc-700 px-4 py-2 text-xs font-semibold text-zinc-200 hover:border-zinc-500">
          GitHub
        </a>
        <a href="https://www.linkedin.com/in/cyrille-nyami-tchamba-649938212/?lipi=urn%3Ali%3Apage%3Ad_flagship3_profile_view_base_contact_details%3BthksV9GhSmeBeYIsF6ydRw%3D%3D
         " target="_blank" rel="noopener noreferrer" class="rounded-lg border border-zinc-700 px-4 py-2 text-xs font-semibold text-zinc-200 hover:border-zinc-500">
          LinkedIn
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
