---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { portfolioContent } from '../data/portfolioData';

const t = portfolioContent.fr;
---

<BaseLayout lang="fr">
  <section class="min-w-0 space-y-6 pb-14 sm:pb-20">
    <span class="inline-flex items-center rounded-md border border-zinc-800 bg-zinc-900/90 px-3 py-1 text-xs font-medium text-indigo-400">
      {t.role}
    </span>
    <h1 class="max-w-4xl break-words text-3xl font-bold leading-[1.12] tracking-tight text-white sm:text-5xl lg:text-6xl">
      {t.heroTitle}
    </h1>
    <p class="max-w-2xl break-words text-base leading-relaxed text-zinc-400 sm:text-lg">
      {t.heroSubtitle}
    </p>
    <div class="flex flex-col gap-3 pt-2 sm:flex-row sm:items-center">
      <a
        href="#projects"
        class="inline-flex w-full items-center justify-center rounded-lg bg-indigo-600 px-5 py-3 text-sm font-semibold text-white transition-colors hover:bg-indigo-500 sm:w-auto sm:py-2.5"
      >
        {t.ctaProjects}
      </a>
      <a
        href="#contact"
        class="inline-flex w-full items-center justify-center rounded-lg border border-zinc-700 bg-zinc-900/70 px-5 py-3 text-sm font-semibold text-zinc-200 transition-colors hover:border-zinc-500 hover:bg-zinc-900 hover:text-white sm:w-auto sm:py-2.5"
      >
        {t.ctaContact}
      </a>
    </div>
  </section>

  <section id="projects" class="min-w-0 space-y-8 border-t border-zinc-800/80 py-14 sm:py-16">
    <div class="min-w-0 space-y-1.5">
      <h2 class="text-2xl font-bold tracking-tight text-white sm:text-3xl">
        {t.sections.projectsTitle}
      </h2>
      <p class="text-sm text-zinc-400 sm:text-base">
        {t.sections.projectsSubtitle}
      </p>
    </div>

    <div class="grid min-w-0 grid-cols-1 gap-6 lg:grid-cols-2">
      {t.projects.map((project) => (
        <ProjectCard project={project} labels={t.labels} />
      ))}
    </div>

    <div class="min-w-0 space-y-3 pt-2">
      <h3 class="text-sm font-semibold uppercase tracking-wider text-zinc-400">
        {t.sections.matrixTitle}
      </h3>
      <div class="w-full overflow-x-auto rounded-xl border border-zinc-800/90 bg-zinc-900/40">
        <table class="w-full min-w-[540px] border-collapse text-left text-sm">
          <thead>
            <tr class="border-b border-zinc-800 bg-zinc-900/80 text-xs font-medium uppercase tracking-wider text-zinc-400">
              <th class="whitespace-nowrap px-4 py-3">{t.sections.matrixHeaders.project}</th>
              <th class="whitespace-nowrap px-4 py-3">{t.sections.matrixHeaders.type}</th>
              <th class="px-4 py-3">{t.sections.matrixHeaders.stack}</th>
              <th class="whitespace-nowrap px-4 py-3">{t.sections.matrixHeaders.status}</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-zinc-800/70 text-zinc-300">
            {t.projectMatrix.map((row) => (
              <tr class="transition-colors hover:bg-zinc-900/60">
                <td class="whitespace-nowrap px-4 py-3.5 font-medium text-white">{row.project}</td>
                <td class="whitespace-nowrap px-4 py-3.5 text-zinc-400">{row.type}</td>
                <td class="px-4 py-3.5 text-zinc-300">{row.stackSummary}</td>
                <td class="whitespace-nowrap px-4 py-3.5">
                  <span class="inline-flex items-center rounded-md border border-emerald-500/30 bg-emerald-500/10 px-2.5 py-0.5 text-xs font-medium text-emerald-300">
                    {row.status}
                  </span>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section id="skills" class="min-w-0 space-y-8 border-t border-zinc-800/80 py-14 sm:py-16">
    <h2 class="text-2xl font-bold tracking-tight text-white sm:text-3xl">
      {t.sections.skillsTitle}
    </h2>
    <div class="grid min-w-0 grid-cols-1 gap-6 md:grid-cols-3">
      {t.skills.map((group) => (
        <div class="min-w-0 rounded-xl border border-zinc-800/90 bg-zinc-900/50 p-6">
          <h3 class="text-sm font-semibold text-white">{group.category}</h3>
          <div class="mt-4 flex flex-wrap gap-2">
            {group.items.map((skill) => (
              <span class="rounded-md border border-zinc-800 bg-zinc-950 px-2.5 py-1 text-xs font-medium text-zinc-300">
                {skill}
              </span>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>

  <section id="about" class="grid min-w-0 grid-cols-1 gap-8 border-t border-zinc-800/80 py-14 sm:py-16 lg:grid-cols-12 lg:gap-10">
    <div class="min-w-0 space-y-4 lg:col-span-5">
      <h2 class="text-2xl font-bold tracking-tight text-white sm:text-3xl">
        {t.sections.aboutTitle}
      </h2>
      <p class="break-words text-sm leading-relaxed text-zinc-400 sm:text-base">
        {t.sections.aboutText}
      </p>
      <div class="flex flex-col gap-2.5 pt-2 sm:flex-row sm:flex-wrap">
        <a
          href="mailto:cyrillenyamitchamba67@gmail.com"
          class="inline-flex min-w-0 items-center justify-center break-all rounded-lg bg-white px-4 py-2.5 text-xs font-semibold text-zinc-950 transition-colors hover:bg-zinc-200 sm:break-normal"
        >
          cyrillenyamitchamba67@gmail.com
        </a>
        <a
          href="https://github.com/cyrille514"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center rounded-lg border border-zinc-700 bg-zinc-900 px-4 py-2.5 text-xs font-semibold text-zinc-200 transition-colors hover:border-zinc-500 hover:text-white"
        >
          GitHub
        </a>
        <a
          href="https://www.linkedin.com/in/cyrille-nyami-tchamba-649938212/?lipi=urn%3Ali%3Apage%3Ad_flagship3_profile_view_base_contact_details%3BthksV9GhSmeBeYIsF6ydRw%3D%3D"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center rounded-lg border border-zinc-700 bg-zinc-900 px-4 py-2.5 text-xs font-semibold text-zinc-200 transition-colors hover:border-zinc-500 hover:text-white"
        >
          LinkedIn
        </a>
      </div>
    </div>

    <div id="contact" class="min-w-0 rounded-xl border border-zinc-800/90 bg-zinc-900/50 p-6 sm:p-7 lg:col-span-7">
      <div class="space-y-1.5">
        <h2 class="text-xl font-bold tracking-tight text-white">{t.sections.contactTitle}</h2>
        <p class="text-sm leading-relaxed text-zinc-400">{t.sections.contactText}</p>
      </div>

      <form id="contact-form-fr" class="mt-6 space-y-4">
        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
          <div class="min-w-0 space-y-1.5">
            <label for="name-fr" class="block text-xs font-medium text-zinc-300">
              {t.form.nameLabel}
            </label>
            <input
              id="name-fr"
              name="name"
              type="text"
              required
              placeholder={t.form.namePlaceholder}
              class="w-full min-w-0 rounded-lg border border-zinc-800 bg-zinc-950 px-3.5 py-2.5 text-sm text-white placeholder-zinc-500 outline-none transition-colors focus:border-indigo-500"
            />
          </div>
          <div class="min-w-0 space-y-1.5">
            <label for="email-fr" class="block text-xs font-medium text-zinc-300">
              {t.form.emailLabel}
            </label>
            <input
              id="email-fr"
              name="email"
              type="email"
              required
              placeholder={t.form.emailPlaceholder}
              class="w-full min-w-0 rounded-lg border border-zinc-800 bg-zinc-950 px-3.5 py-2.5 text-sm text-white placeholder-zinc-500 outline-none transition-colors focus:border-indigo-500"
            />
          </div>
        </div>

        <div class="min-w-0 space-y-1.5">
          <label for="message-fr" class="block text-xs font-medium text-zinc-300">
            {t.form.messageLabel}
          </label>
          <textarea
            id="message-fr"
            name="message"
            rows="4"
            required
            placeholder={t.form.messagePlaceholder}
            class="w-full min-w-0 rounded-lg border border-zinc-800 bg-zinc-950 px-3.5 py-2.5 text-sm text-white placeholder-zinc-500 outline-none transition-colors focus:border-indigo-500"
          ></textarea>
        </div>

        <div class="flex flex-col gap-3 pt-1 sm:flex-row sm:items-center sm:justify-between">
          <button
            type="submit"
            class="inline-flex w-full items-center justify-center rounded-lg bg-indigo-600 px-5 py-2.5 text-xs font-semibold text-white transition-colors hover:bg-indigo-500 sm:w-auto"
          >
            {t.form.submitButton}
          </button>
          <p id="form-status-fr" role="status" class="text-xs text-zinc-400"></p>
        </div>
      </form>
    </div>
  </section>

  <script define:vars={{ sentNotice: t.form.sentNotice }}>
    const form = document.getElementById('contact-form-fr');
    const statusEl = document.getElementById('form-status-fr');
    if (form instanceof HTMLFormElement && statusEl) {
      form.addEventListener('submit', (event) => {
        event.preventDefault();
        const data = new FormData(form);
        const name = String(data.get('name') ?? '').trim();
        const email = String(data.get('email') ?? '').trim();
        const message = String(data.get('message') ?? '').trim();
        const subject = encodeURIComponent(`Portfolio — ${name}`);
        const body = encodeURIComponent(`Nom: ${name}\nE-mail: ${email}\n\n${message}`);
        statusEl.textContent = sentNotice;
        window.location.href = `mailto:cyrillenyamitchamba67@gmail.com?subject=${subject}&body=${body}`;
      });
    }
  </script>
</BaseLayout>
