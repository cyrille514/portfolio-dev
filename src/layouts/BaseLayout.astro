---
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import { portfolioContent, type Lang } from '../data/portfolioData';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const content = portfolioContent[lang];
---

<!doctype html>
<html lang={lang} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{content.metaTitle}</title>
  </head>
  <body class="min-h-screen bg-zinc-950 text-zinc-100 antialiased">
    <Navbar lang={lang} nav={content.nav} />
    <main class="mx-auto max-w-5xl px-4 py-12 sm:px-6 sm:py-16">
      <slot />
    </main>
    <footer class="border-t border-zinc-800/80 py-8 text-center text-xs text-zinc-500">
      © {new Date().getFullYear()} Cyrille Nyami — Fullstack Web Developer
    </footer>
  </body>
</html>
